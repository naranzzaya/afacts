<div id="<%= dom_id meetup %>">
  <p>
    <strong>Title:</strong>
    <%= meetup.title %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= meetup.description %>
  </p>

  <p>
    <strong>Starts at:</strong>
    <%= meetup.starts_at %>
  </p>

  <p>
    <strong>Ends at:</strong>
    <%= meetup.ends_at %>
  </p>

  <p>
    <strong>Stream url:</strong>
    <%= meetup.stream_url %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= meetup.status %>
  </p>

</div>
