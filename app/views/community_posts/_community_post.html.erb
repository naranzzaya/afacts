<div id="<%= dom_id community_post %>">
  <p>
    <strong>User:</strong>
    <%= community_post.user_id %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= community_post.title %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= community_post.body %>
  </p>

  <p>
    <strong>Post type:</strong>
    <%= community_post.post_type %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= community_post.status %>
  </p>

</div>
