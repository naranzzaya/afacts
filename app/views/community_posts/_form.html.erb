<%= form_with(model: community_post) do |form| %>
  <% if community_post.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(community_post.errors.count, "error") %> prohibited this community_post from being saved:</h2>

      <ul>
        <% community_post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :user_id, style: "display: block" %>
    <%= form.text_field :user_id %>
  </div>

