<%= form_with(model: community_post, html: { multipart: true }) do |f| %>
<%= f.label :title %>
<%= f.text_field :title %>

<%= f.label :body %>
<%= f.text_area :body %>

<%= f.label :post_type %>
<%= f.select :post_type, CommunityPost.post_types.keys %>

<%= f.label :media, "Изображения/видео" %>
<%= f.file_field :media, multiple: true %>

<%= f.submit %>
<% end %>