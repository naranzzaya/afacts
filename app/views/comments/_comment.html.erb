<div id="<%= dom_id comment %>">
  <p>
    <strong>Community post:</strong>
    <%= comment.community_post_id %>
  </p>

  <p>
    <strong>User:</strong>
    <%= comment.user_id %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= comment.body %>
  </p>

  <p>
    <strong>Parent:</strong>
    <%= comment.parent_id %>
  </p>

</div>
