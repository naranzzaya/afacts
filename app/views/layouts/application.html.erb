<!DOCTYPE html>
<html>

<head>
    <title>VFX Media</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
</head>

<body>
    <nav class="menuBar">
        <div>
            <%= link_to "Главная", root_url %>
            <%= link_to "Учебник", lessons_url %>
            <%= link_to "Статьи", articles_url %>
            <%= link_to "Коммьюнити", community_posts_url %>
            <%= link_to "О нас", about_url %>
        </div>

        <div>
            <% if user_signed_in? %>
            <%= link_to current_user.email, edit_user_registration_path %>
            <%= link_to "Выйти", destroy_user_session_path, data: { "turbo-method": :delete } %>
            <% else %>
            <%= link_to "Войти", new_user_session_path %>
            <%= link_to "Зарегистрироваться", new_user_registration_path %>
            <% end %>
        </div>
    </nav>

    <%= yield %>
</body>

</html>